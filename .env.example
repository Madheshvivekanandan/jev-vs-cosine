# Copy to .env (git-ignored) and pick ONE Jev route block. Methods A and C need none of this.

# --- Route 1 (default, $0): OpenCode Zen free model -------------------------------------
# No account, no card. "public" is OpenCode's anonymous key value, not a secret.
# A per-IP daily request cap (value unpublished) resets at 00:00 UTC, and every request
# counts against it, so retries are off. Offered for a "limited time" (no end date).
JEV_API_KEY=public
JEV_BASE_URL=https://opencode.ai/zen
JEV_MODEL=jev-1.13-free
JEV_MAX_RETRIES=0
JEV_MIN_SECONDS_BETWEEN_CALLS=1
# Free route, so the token cap is a runaway guard, not a cost limit. The full plan
# (B, B+ and three probes) needs about 5.6M input tokens.
JEV_MAX_TOTAL_INPUT_TOKENS=8000000

# --- Route 2 ($0 with a card on file): Vercel AI Gateway --------------------------------
# Draws on Vercel's $5/month free credit; Vercel requires a credit card on the team first.
# The model id is unversioned, so answers are not pinned to a Jev release.
# JEV_API_KEY=<your AI Gateway key>
# JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe
# JEV_MODEL=typesafe-ai/jev

# --- Route 3: TypeSafe direct (existing accounts; new signups paused since 2026-09-22) --
# JEV_API_KEY=<key from console.typesafe.ai/keys>
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.13.0

# --- Safety and tuning (defaults shown) --------------------------------------------------
# Hard stop: total Jev input tokens across all runs, including cached ones.
# JEV_MAX_TOTAL_INPUT_TOKENS=3000000
# JEV_TIMEOUT_SECONDS=30
# JEV_MAX_RETRIES=2
# JEV_MIN_SECONDS_BETWEEN_CALLS=0
# List price used for the "what it would cost" column (USD per 1M input tokens).
# JEV_PRICE_USD_PER_MILLION_INPUT_TOKENS=0.042

# --- Pinned experiment inputs (change only on purpose; results depend on them) ----------
# EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
# CROSS_ENCODER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# CROSS_ENCODER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
# CATALOG_PATH=prompts/banking77_intents.v1.json
# PROBES_DIR=probes
# REFERENCE_CASES_PATH=fingerprints/typesafe_reference.v2.json
# DATA_DIR=data
# CACHE_DIR=.cache
# RESULTS_DIR=results
# LOG_LEVEL=INFO
